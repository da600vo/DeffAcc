      "position": [
        440,
        100
      ],
      "parameters": {
        "jsCode": "// Normaliza la entrada: el Webhook la trae en body; los ejemplos, en la raíz.\nconst src = $json.body ?? $json;\nif (!src.code) throw new Error('Falta \"code\" en la entrada');\nreturn { json: {\n  skill_id: src.skill_id ?? 'sin-id',\n  code: src.code,\n  language: src.language ?? 'python',\n  demo_patch: src.demo_patch ?? null,\n} };",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "956c3c80-2120-4084-b8ed-9a1e06dc0459",
