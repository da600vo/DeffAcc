      "name": "Ejemplos demo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Cuatro casos de demo. Cada uno termina en una salida distinta.\n// demo_patch solo lo usa la API simulada para elegir el parche; la API real lo ignora.\nconst original = \"import os\\n\\ndef ping(host):\\n    os.system(\\\"ping -c 1 \\\" + host)\\n    return True\\n\";\nconst limpio = \"import subprocess\\n\\ndef ping(host):\\n    subprocess.run([\\\"ping\\\", \\\"-c\\\", \\\"1\\\", host], check=False)\\n    return True\\n\";\nreturn [\n  { json: { skill_id: 'demo-1-limpia',        code: limpio,   language: 'python' } },                              // -> APROBADO\n  { json: { skill_id: 'demo-2-ping-arreglado', code: original, language: 'python', demo_patch: 'fixed' } },          // -> PARCHE PROPUESTO\n  { json: { skill_id: 'demo-3-ping-trampa',    code: original, language: 'python', demo_patch: 'fake_fix' } },       // -> CUARENTENA\n  { json: { skill_id: 'demo-4-ping-inseguro',  code: original, language: 'python', demo_patch: 'still_insecure' } }, // -> CUARENTENA\n];"
      }
    },
    {
      "id": "72f4f5ca-495e-4ebf-8ff5-16c30f4e3383",
