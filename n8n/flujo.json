      ],
      "parameters": {
        "jsCode": "// Une las dos ramas (Gemini o línea base) en un solo formato: {patched_code, model}\nreturn { json: { patched_code: $json.patched_code, model: $json.model } };",
        "mode": "runOnceForEachItem"
      }
    },
