      "id": "d1a310cb-0a52-4da8-8dc8-3c4005044b33",
      "name": "Ejemplos demo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Cuatro casos de demo. Cada uno termina en una salida distinta.\n// method elige el parcheador: gemini (nuestro) o las líneas base de la evaluación (delete_line, noop).\nconst original = \"import os\\n\\ndef ping(host):\\n    os.system(\\\"ping -c 1 \\\" + host)\\n    return True\\n\";\nconst limpio = \"import subprocess\\n\\ndef ping(host):\\n    subprocess.run([\\\"ping\\\", \\\"-c\\\", \\\"1\\\", host], check=False)\\n    return True\\n\";\nreturn [\n  { json: { skill_id: 'demo-1-limpia',        code: limpio,   language: 'python' } },                              // -> APROBADO (sin hallazgos)\n  { json: { skill_id: 'demo-2-ping-arreglado', code: original, language: 'python', method: 'gemini' } },             // gemini -> PARCHE PROPUESTO si verify da fixed\n  { json: { skill_id: 'demo-3-ping-trampa',    code: original, language: 'python', method: 'delete_line' } },        // borra la línea -> verify: fake_fix -> CUARENTENA\n  { json: { skill_id: 'demo-4-ping-inseguro',  code: original, language: 'python', method: 'noop' } },               // no cambia nada -> verify: still_insecure -> CUARENTENA\n];"
      }
    },
    {
      "id": "87ea3639-4bc4-4648-95f2-cff5da0ae34c",
