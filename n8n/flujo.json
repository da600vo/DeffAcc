    {
      "id": "5d984c2d-1b0a-491f-8762-3a6ddf0f2b15",
      "name": "Línea base (noop / delete_line)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        120
      ],
      "parameters": {
        "jsCode": "// Líneas base de la evaluación, igual que baseline_patches.py:\n//  noop        -> deja el código igual\n//  delete_line -> borra la(s) línea(s) marcada(s) por el escáner (silencia al escáner, no arregla nada)\nconst e = $('Entrada').item.json;\nconst s = $('POST /scan').item.json;\nconst lines = e.code.split('\\n');\nlet patched = e.code;\nif (e.method === 'delete_line') {\n  const targets = new Set(s.findings.map(f => (lines[f.line - 1] ?? '').trim()).filter(t => t));\n  patched = lines.filter(l => !targets.has(l.trim())).join('\\n');\n}\nreturn { json: { patched_code: patched, model: e.method } };",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "36465937-1ab7-4607-8942-382d5d1e46d9",
      "name": "Parche",
      "type": "n8n-nodes-base.code",
