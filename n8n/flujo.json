    {
      "id": "2d1506d4-a683-4493-b410-3da51f6bdfcc",
      "name": "PARCHE PROPUESTO",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        -100
      ],
      "parameters": {
        "jsCode": "function diff(a, b) {\n  const A = a.split('\\n'), B = b.split('\\n');\n  return [\n    ...A.filter(l => l.trim() && !B.includes(l)).map(l => '- ' + l),\n    ...B.filter(l => l.trim() && !A.includes(l)).map(l => '+ ' + l),\n  ];\n}\nconst e = $('Entrada').item.json;\nconst s = $('POST /scan').item.json;\nconst p = $('POST /patch').item.json;\nconst v = $json;\nreturn { json: {\n  skill_id: e.skill_id,\n  decision: 'parche_propuesto',\n  aplicado: false,\n  cwe: [...new Set(s.findings.map(f => f.cwe))],\n  findings: s.findings,\n  model: p.model,\n  diff: diff(e.code, p.patched_code),\n  patched_code: p.patched_code,\n  verificacion: { status: v.status, reasons: v.reasons, original_parses: v.original_parses },\n} };",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "daab705d-3116-4bc8-bf40-aa7d48dc82aa",
      "name": "CUARENTENA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        120
      ],
      "parameters": {
        "jsCode": "function diff(a, b) {\n  const A = a.split('\\n'), B = b.split('\\n');\n  return [\n    ...A.filter(l => l.trim() && !B.includes(l)).map(l => '- ' + l),\n    ...B.filter(l => l.trim() && !A.includes(l)).map(l => '+ ' + l),\n  ];\n}\nconst e = $('Entrada').item.json;\nconst s = $('POST /scan').item.json;\nconst p = $('POST /patch').item.json;\nconst v = $json;\nreturn { json: {\n  skill_id: e.skill_id,\n  decision: 'cuarentena',\n  motivo: v.status ?? 'estado_desconocido',\n  accion: 'revisión de especialista; el parche NO se aplica',\n  evidencia: {\n    cwe: [...new Set(s.findings.map(f => f.cwe))],\n    findings: s.findings,\n    reasons: v.reasons ?? [],\n    original_parses: v.original_parses,\n    model: p.model,\n    diff: diff(e.code, p.patched_code ?? ''),\n    original_code: e.code,\n    patched_code: p.patched_code,\n  },\n} };",
        "mode": "runOnceForEachItem"
      }
    },
