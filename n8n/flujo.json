        440,
        100
      ],
      "parameters": {
        "jsCode": "// Normaliza la entrada: el Webhook la trae en body; los ejemplos, en la raíz.\nconst src = $json.body ?? $json;\nif (!src.code) throw new Error('Falta \"code\" en la entrada');\nreturn { json: {\n  skill_id: src.skill_id ?? 'sin-id',\n  code: src.code,\n  language: src.language ?? 'python',\n  method: src.method ?? 'gemini',\n} };",
        "mode": "runOnceForEachItem"
      }
    },
